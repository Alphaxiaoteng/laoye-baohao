# 复制为 .env 仅供本地开发（服务端启动时自动读取）；不要提交真实密钥。
# 部署时（Docker / 平台）请把 LLM_API_KEY 配成服务端环境变量或 Secret，不要写进仓库。
# OpenAI 兼容上游（默认 OpenAI Next / DeepSeek V4.1 Flash）
# LLM_BASE_URL 可以写 .../v1，也可以直接写完整的 .../v1/chat/completions
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=deepseek-v4-1-flash-261017
LLM_API_KEY=

# 服务端口，默认 7860（监听 0.0.0.0）
PORT=7860

# 小红书攻略抓取（scripts/fetch-xhs-guide.mjs），只在本机跑，不进前端
TIKHUB_API_KEY=

# 可选：站外检索兜底（不配置则完全关闭，站内检索不足时才会调用）
# 端点需接受 ?q= 查询参数并返回 { results: [{ title, url, content }] } 或同结构数组
WEB_SEARCH_URL=
WEB_SEARCH_KEY=
